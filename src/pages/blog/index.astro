---
import Layout from '../../layouts/Layout.astro';
import '../../styles/blog.css';

interface Post {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
    url: string;
}

const postFiles = import.meta.glob<{ frontmatter: Post }>('./*.md', { eager: true });

const sorted: Post[] = Object.entries(postFiles)
    .map(([path, mod]) => ({
        ...mod.frontmatter,
        url: `${import.meta.env.BASE_URL}blog/` + path.replace('./', '').replace('.md', '') + '/',
    }))
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const allTags = [...new Set(sorted.flatMap(p => p.tags ?? []))].sort();

function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    });
}
---
<Layout pageTitle={frontmatter.title}>
    <div class="page-container">

        <div class="post-header">
            <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">← Blog</a>

            <h1 class="post-title">{frontmatter.title}</h1>

            <div class="post-meta">
                <time datetime={frontmatter.date}>
                    {dateStr}
                </time>

                {frontmatter.tags && (
                    <div class="post-tags">
                        {frontmatter.tags.map((tag: string) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )}
            </div>

            {frontmatter.description && (
                <p class="post-description">{frontmatter.description}</p>
            )}
        </div>

        <article class="post-body">
            <slot />
        </article>

        <div class="post-footer">
            <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">
                ← Back to all posts
            </a>
        </div>

    </div>
</Layout>