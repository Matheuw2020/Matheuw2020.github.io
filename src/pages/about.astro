---
import Layout from './Layout.astro';
import '../styles/blog.css';

const { frontmatter } = Astro.props;
---

<Layout pageTitle={frontmatter.title}>
    <div class="page-container">

        <div class="post-header">
            <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">← Blog</a>

            <h1 class="post-title">{frontmatter.title}</h1>

            <div class="post-meta">

                <!-- 🔥 INPUT EN LUGAR DE FECHA -->
                <input
                    type="text"
                    class="post-input"
                    placeholder="Escribe una nota o etiqueta..."
                />

                {frontmatter.tags && (
                    <div class="post-tags">
                        {frontmatter.tags.map((tag: string) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )}

            </div>

            {frontmatter.description && (
                <p class="post-description">{frontmatter.description}</p>
            )}
        </div>

        <article class="post-body">
            <slot />
        </article>

        <div class="post-footer">
            <a href={`${import.meta.env.BASE_URL}blog/`} class="back-link">
                ← Back to all posts
            </a>
        </div>

    </div>
</Layout>